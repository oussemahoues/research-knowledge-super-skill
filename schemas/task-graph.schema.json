{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research Task Graph",
  "type": "object",
  "required": ["schema_version", "run_id", "tasks", "merge_owner"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "run_id": {"type": "string"},
    "merge_owner": {"type": "string"},
    "tasks": {"type": "array", "items": {"type": "object", "required": ["id", "objective", "consumes", "produces", "dependencies", "owner", "budget", "done_when"]}}
  }
}
