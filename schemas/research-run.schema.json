{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/evidence-research/research-run.schema.json",
  "title": "Evidence Research Run",
  "type": "object",
  "required": ["schema_version", "run_id", "state", "target", "questions", "acceptance_criteria", "as_of", "thresholds", "history"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "run_id": {"type": "string", "pattern": "^run:[a-z0-9-]+:[0-9a-f]{12}$"},
    "state": {"enum": ["SCOPED", "PLANNED", "ACQUIRING", "EXTRACTING", "RESOLVING", "VERIFYING", "SYNTHESIZING", "AUDITING", "COMPLETE", "BLOCKED"]},
    "resume_state": {"type": ["string", "null"]},
    "target": {"type": "string", "minLength": 10},
    "questions": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "text", "kind"]}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "criterion", "measure"]}},
    "as_of": {"type": "string", "format": "date"},
    "thresholds": {"type": "object"},
    "budgets": {"type": "object"},
    "history": {"type": "array", "minItems": 1}
  },
  "additionalProperties": true
}
