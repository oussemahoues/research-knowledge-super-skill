{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence Research v3 Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_id", "run_id", "task_id", "path", "content_hash", "media_type", "created_at"],
  "properties": {
    "artifact_id": {"type": "string"},
    "run_id": {"type": "string"},
    "task_id": {"type": "string"},
    "path": {"type": "string"},
    "content_hash": {"pattern": "^(sha256:|hash:).+"},
    "media_type": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
