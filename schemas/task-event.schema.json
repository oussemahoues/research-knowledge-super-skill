{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence Research v3 Task Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "event_type", "idempotency_key", "created_at", "payload"],
  "properties": {
    "schema_version": {"const": "3.0"},
    "run_id": {"type": "string", "minLength": 1},
    "event_type": {"enum": ["RUN_CREATED", "TASK_GRAPH_REGISTERED", "TASK_READY", "TASK_STARTED", "TASK_SUCCEEDED", "TASK_FAILED", "CHECKPOINT_WRITTEN", "INTERRUPT_OPENED", "INTERRUPT_RESOLVED"]},
    "idempotency_key": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "payload": {"type": "object"}
  }
}
